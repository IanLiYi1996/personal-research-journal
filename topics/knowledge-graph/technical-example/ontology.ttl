@prefix ex:   <https://example.org/onto-tech/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:ontology a owl:Ontology ;
    owl:versionIRI <https://example.org/onto-tech/versions/0.1.0> ;
    owl:versionInfo "0.1.0" .

ex:Product a owl:Class .
ex:Release a owl:Class .
ex:EnterpriseRelease a owl:Class ;
    rdfs:subClassOf ex:Release .
ex:Capability a owl:Class .
ex:SupportClaim a owl:Class .
ex:Evidence a owl:Class .

ex:releaseOf a owl:ObjectProperty ;
    rdfs:domain ex:Release ;
    rdfs:range ex:Product ;
    owl:inverseOf ex:hasRelease .
ex:hasRelease a owl:ObjectProperty .
ex:forRelease a owl:ObjectProperty ;
    rdfs:domain ex:SupportClaim ;
    rdfs:range ex:Release .
ex:capability a owl:ObjectProperty ;
    rdfs:domain ex:SupportClaim ;
    rdfs:range ex:Capability .
ex:hasEvidence a owl:ObjectProperty ;
    rdfs:domain ex:SupportClaim ;
    rdfs:range ex:Evidence .

ex:version a owl:DatatypeProperty ;
    rdfs:domain ex:Release ;
    rdfs:range xsd:string .
ex:environment a owl:DatatypeProperty ;
    rdfs:domain ex:SupportClaim ;
    rdfs:range xsd:string .
ex:status a owl:DatatypeProperty ;
    rdfs:domain ex:SupportClaim ;
    rdfs:range xsd:string .
ex:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
ex:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
ex:quote a owl:DatatypeProperty ;
    rdfs:domain ex:Evidence ;
    rdfs:range xsd:string .
ex:locator a owl:DatatypeProperty ;
    rdfs:domain ex:Evidence ;
    rdfs:range xsd:string .
