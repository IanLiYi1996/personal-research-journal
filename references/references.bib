  author = {Aakanksha Chowdhery and Sharan Narang and Jacob Devlin and Noam Shazeer and Denny Zhou and Andrew M Dai and Nan Du and James Bradbury and Guy Gur-ari and David Luan and Kevin Robinson and Mark Diaz and Oleksandr Polozov and Katherine Lee and Jeff Dean and Michele Catasta and Jason Wei and Kathy Meier-hellstern},
