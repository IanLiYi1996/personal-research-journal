  author = {Shikhar Vashishth and Soumya Sanyal and Vikram Nitin and Partha Talukdar},
  pages = {1-16},
  title = {COMPOSITION-BASED MULTI-RELATIONAL GRAPH CONVOLUTIONAL NETWORKS},
